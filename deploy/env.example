# Copy to <DEPLOY_PATH>/shared/.env on the server and fill in.
# Passed to the container (env_file in deploy/docker-compose.yml).
SECRET_KEY=change-me
# docker (image built on the server, docker compose) or systemd (virtualenv + systemd service)
DEPLOY_METHOD=docker
# 127.0.0.1 is needed for the health check after deploy
ALLOWED_HOSTS=rustdesk-api.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://rustdesk-api.example.com
TIME_ZONE=UTC
# Address of hbbs and the public key from its data directory (data/id_ed25519.pub)
ID_SERVER=
RUSTDESK_KEY=
RUSTDESK_CONFIG=
# Several instances on one server (e.g. staging next to production) need
# different names and ports. Defaults: rustdesk-api and 21114.
#INSTANCE_NAME=rustdesk-api-staging
#APP_PORT=21115
# Checked by the deploy script after start; by default http://127.0.0.1:<APP_PORT>/api/user_action
#HEALTHCHECK_URL=
# systemd method only: name of the service restarted after deploy
SERVICE_NAME=rustdesk-api
