# Copy to <DEPLOY_PATH>/shared/.env on the server and fill in.
# Passed to the container (env_file in deploy/docker-compose.yml).
SECRET_KEY=change-me
# docker (image built on the server, docker compose) or systemd (virtualenv + systemd service)
DEPLOY_METHOD=docker
# 127.0.0.1 is needed for the health check after deploy
ALLOWED_HOSTS=rustdesk-api.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://rustdesk-api.example.com
TIME_ZONE=UTC
# Address of hbbs and the public key from its data directory (data/id_ed25519.pub).
# With ID_SERVER set, the installer scripts are served with the server settings
# filled in (RUSTDESK_CONFIG is generated from these values).
ID_SERVER=
RUSTDESK_KEY=
# Address of hbbr, if it differs from ID_SERVER
#RELAY_SERVER=
# Public address of this API for clients, by default the address the page is opened with
#API_URL=https://rustdesk-api.example.com
# Ready configuration string exported from a client; overrides the generated one
#RUSTDESK_CONFIG=
# RustDesk client version downloaded by the installer scripts
#RUSTDESK_VERSION=1.3.9
# Host network mode: listen only on this address, e.g. 127.0.0.1 when the reverse
# proxy (Nginx Proxy Manager) runs on the same host with network_mode: host
#BIND_ADDRESS=127.0.0.1
# Docker network mode: host (default, port open on all interfaces like hbbs/hbbr)
# or proxy (only reachable from a reverse proxy container such as Nginx Proxy Manager
# on the Docker network PROXY_NETWORK, and from 127.0.0.1 on the host)
#NETWORK_MODE=proxy
#PROXY_NETWORK=npm_default
# Set when a reverse proxy terminates HTTPS, so generated links use https
#BEHIND_PROXY=true
# Several instances on one server (e.g. staging next to production) need
# different names and ports. Defaults: rustdesk-api and 21114.
#INSTANCE_NAME=rustdesk-api-staging
#APP_PORT=21115
# Checked by the deploy script after start; by default http://127.0.0.1:<APP_PORT>/api/user_action
#HEALTHCHECK_URL=
# systemd method only: name of the service restarted after deploy
SERVICE_NAME=rustdesk-api
