# Copy to <DEPLOY_PATH>/shared/.env on the server and fill in.
# Used by the service (EnvironmentFile) and by deploy/remote-deploy.sh.
SECRET_KEY=change-me
# 127.0.0.1 is needed for the health check after deploy
ALLOWED_HOSTS=rustdesk-api.example.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://rustdesk-api.example.com
DB_PATH=/opt/rustdesk-api/shared/db/db.sqlite3
TIME_ZONE=UTC
ID_SERVER=
RUSTDESK_KEY=
RUSTDESK_CONFIG=
# Deploy script settings
SERVICE_NAME=rustdesk-api
HEALTHCHECK_URL=http://127.0.0.1:21114/api/user_action
